{
  "name": "zotero-viewflow",
  "version": "13.1.4",
  "description": "Preview and copy formatted references in Zotero's item pane.",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build:bundle": "npm run typecheck && node scripts/build-source.mjs",
    "build:xpi": "pwsh -NoProfile -File scripts/build.ps1",
    "build": "npm run typecheck && npm run build:xpi",
    "test:syntax": "node --check bootstrap.js zoteropreview.js zoteropreview_prefs.js",
    "test:unit": "node --test-concurrency=1 --experimental-strip-types --test tests/*.test.cjs",
    "test": "npm run build:bundle && npm run test:syntax && npm run test:unit",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node --experimental-strip-types --test tests/architecture.test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "zotero-types": "^4.1.3"
  }
}
